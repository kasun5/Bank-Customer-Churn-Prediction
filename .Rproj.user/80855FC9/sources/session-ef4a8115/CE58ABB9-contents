## 4

### a)

covariance matrix, 𝑆
```{r}
Y <- matrix(c(
  2, 2, 6, 12,
  3, 5, 7, 8,
  10, 1, 1, 17,
  6, 5, 7, 11,
  7, 2, 6, 17,
  8, 9, 3, 1
), nrow = 6, byrow = TRUE)

Y

n<-nrow(Y)
#Creating a nxn=5x5 identity matrix 
I<-diag(n)

#creating a nx1=5x1 matrix with ones
l<-matrix(1,n,1)

options(scipen = 999) ## Set option to suppress scientific notation

#Calculating the variance covariance matrix
S<-(1/(n-1))*t(Y)%*%(I-(1/n)*l%*%t(l))%*%Y
round(S,digits = 3)
```

### b)
generalized sample variance
```{r}
gen_s <- det(S)
round(gen_s,digits = 3)

```

### c)
total sample variance
```{r}
total_s <- sum(diag(S))

```

### d)
eigenvalues and eigenvectors of S
```{r}
#eigenvaules and eigenvectors
eg<-eigen(S)

#eigenvaules
lamda<-round(eg$values, digits=3)
lamda

#eigenvectors
V<-round(eg$vectors, digits=4)
V


```

### e)
vector 𝑎 that establishes the dependence
```{r}
