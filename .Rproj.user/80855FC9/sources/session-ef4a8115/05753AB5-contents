#############################################################################################################
#############  Test 1 with all the features #############################
test1 <- customerDataFinal

# Determine the optimal number of clusters using the Elbow Method
set.seed(42)  # For reproducibility
wss <- sapply(1:10, function(k) {
  kmeans(test1, centers = k,iter.max=500, nstart = 25)$tot.withinss
})

# Create a data frame for plotting
elbow_data <- data.frame(
  k = 1:10,
  wss = wss
)

# Plot the elbow curve
elbow_plot <- ggplot(elbow_data, aes(x = k, y = wss)) +
  geom_line(color = "blue") +
  geom_point(color = "red") +
  ggtitle("Elbow Curve for Optimal Clusters") +
  xlab("Number of Clusters (k)") +
  ylab("Total Within-Cluster Sum of Squares (WSS)") +
  theme_minimal()
print(elbow_plot)

# silhouette method
fviz_nbclust(test1, kmeans, method='silhouette')

# gap metod
gap_stat <- clusGap(test1, FUN = kmeans, nstart = 25,
                    K.max = 10, B = 50)

fviz_gap_stat(gap_stat)


# Perform k-means clustering with the chosen number of clusters (e.g., k = 3)
set.seed(42)
kmeans_result1 <- kmeans(test1, centers = 3, nstart = 25)

# Calculate silhouette score
silhouette_obj <- silhouette(kmeans_result1$cluster, dist(test1))
silhouette_avg <- mean(silhouette_obj[, 3])

# Print the average silhouette score
cat("The average silhouette score is:", round(silhouette_avg, 3), "\n")

fviz_cluster(kmeans_result1, data = test1)


