## Example 3.16
Hypotheses:

H0: Course 1 and 2 come from identically distributed population
H1: Course 1 and 2 come population are not identically distributed

```{r}
# install.packages("DescTools")

library(DescTools)

# Sample data for two populations
pop1 <- c(100, 84, 85, 90, 83, 79, 60, 61, 90, 87)
pop2 <- c(96, 82, 24, 59, 91, 88, 95, 61)

# Run the Wald-Wolfowitz Two-Sample Runs Test
# By providing both x and y, it automatically acts as the 2-sample version
result <- RunsTest(x = pop1, y = pop2)

print(result)

```

## Example 3.17

```{r}
runstest_2samp_normalApprox <- function(x1, x2) {
  n1 <- length(x1)
  n2 <- length(x2)
  
  # Combine and assign group labels (0 for x1, 1 for x2)
  combined_values <- c(x1, x2)
  groups <- c(rep(0, n1), rep(1, n2))
  
  # Sort the groups based on the combined values
  sorted_indices <- order(combined_values)
  sorted_groups <- groups[sorted_indices]
  
  # Count runs
  # sum(a != b) is a fast vectorized way to count transitions in R
  runs <- sum(sorted_groups[-1] != sorted_groups[-length(sorted_groups)]) + 1
  
  # Normal approximation formulas
  expected <- ((2 * n1 * n2) / (n1 + n2)) + 1
  variance <- (2 * n1 * n2 * (2 * n1 * n2 - n1 - n2)) / (((n1 + n2)^2) * (n1 + n2 - 1))
  sd <- sqrt(variance)
  
  # Z-statistic with continuity correction (0.5)
  z <- (abs(runs - expected) - 0.5) / sd
  
  # P-value calculation
  # pnorm is the R equivalent of stats.norm.cdf
  p_val <- 1 - pnorm(z) 
  
  return(list(runs = runs, expected = expected, z = z, p_val = p_val))
}

# Data
sample1 <- c(100, 84, 85, 90, 83, 79, 60, 61, 90, 87)
sample2 <- c(96, 82, 24, 59, 91, 88, 95, 61)

# Perform the Wald-Wolfowitz runs test
results <- runstest_2samp_normalApprox(sample1, sample2)

# Print formatted results
cat(sprintf("Z-statistic: %.7f\n", results$z))
cat(sprintf("P-value: %.7f\n", results$p_val))

# Interpret the result
alpha <- 0.05
if (results$p_val < alpha) {
  cat("\nReject the null hypothesis: The two samples likely come from different distributions.\n")
} else {
  cat("\nFail to reject the null hypothesis: There is not enough evidence to say the two samples are from different distributions.\n")
}
```

