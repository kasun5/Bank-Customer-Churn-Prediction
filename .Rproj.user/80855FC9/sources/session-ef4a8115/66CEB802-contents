## Example 2.7

```{r}

binomial_ci_example <- function(n, s, alpha=0.05) {
  p_hat <- s / n
  
  # qnorm is the R equivalent of norm.ppf (Percent Point Function / Quantile)
  z_alpha_2 <- qnorm(1 - alpha/2)
  
  # --- a. Normal Approximation ---
  se <- sqrt((p_hat * (1 - p_hat)) / n)
  margin_error <- z_alpha_2 * se
  lower_norm <- p_hat - margin_error
  upper_norm <- p_hat + margin_error
  
  # --- b. Exact Binomial Confidence Interval (F-distribution) ---
  # Lower Bound Formula
  df1_L <- 2 * (n - s + 1)
  df2_L <- 2 * s
  
  # qf is the R equivalent of f.ppf
  f_val_L <- qf(1 - alpha/2, df1_L, df2_L)
  
  if (s == 0) {
    p_lower_exact <- 0.0
  } else {
    p_lower_exact <- 1 / (1 + ((n - s + 1) / s) * f_val_L)
  }
  
  # Upper Bound Formula
  df1_U <- 2 * (s + 1)
  df2_U <- 2 * (n - s)
  f_val_U <- qf(1 - alpha/2, df1_U, df2_U)
  
  if (s == n) {
    p_upper_exact <- 1.0
  } else {
    term_U <- ((s + 1) / (n - s)) * f_val_U
    p_upper_exact <- term_U / (1 + term_U)
  }
  
  # Return results as a named list
  return(list(
    p_hat = p_hat,
    normal = c(max(0, lower_norm), min(1, upper_norm)),
    exact = c(p_lower_exact, p_upper_exact)
  ))
}

# --- Solve Example 2.7 ---
n_val <- 50
s_val <- 47
results <- binomial_ci_example(n_val, s_val)

# Print results using sprintf for formatted output
cat(sprintf("Sample Proportion (p-hat): %.2f\n", results$p_hat))
cat(sprintf("95%% CI (Normal Approximation): [%.4f, %.4f]\n", results$normal[1], results$normal[2]))
cat(sprintf("95%% CI (Exact Binomial):      [%.4f, %.4f]\n", results$exact[1], results$exact[2]))


```

## Example 2.12
Hypotheses:

H0: There is no upward trend in the data
H1: There is an upward trend in the data

```{r}
# install.packages("randtests")

library(randtests)

data <- c(
  51230, 49886, 56580, 46672, 59220, 56716, 56594, 61750, 61898, 68786,
  67758, 78269, 81543, 71419, 83243, 86095, 88270, 75732, 78485, 90715,
  92587, 97810, 96662, 91805, 96462, 89130, 102051, 101160, 100073, 109700
)

# Run the test
result <- cox.stuart.test(data)

# Print formatted results
cat(sprintf("Z-statistic: %.7f\n", result$statistic))
cat(sprintf("P-value: %.7f\n", result$p.value))

# Interpret the result
alpha <- 0.05
if (result$p.value < alpha) {
  cat("\nReject the null hypothesis: There is an upward trend in the data.\n")
} else {
  cat("\nFail to reject the null hypothesis: There is not enough evidence to say there is an upward trend in the data.\n")
}

```
