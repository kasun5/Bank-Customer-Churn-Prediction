
#---------------------------------------------
# Example 5.11: T^2, Confidence Ellipse, and Control Chart
#---------------------------------------------

#---------------------------------------------
# Reading Data
#---------------------------------------------

data1 <- read.table("Example5_11.txt", header = TRUE)
data1 <- as.data.frame(data1)

#---------------------------------------------
# Hotelling's T^2 / Squared Mahalanobis Distances
#---------------------------------------------

# Covariance matrix and mean vector
S <- cov(data1)
xb <- colMeans(data1)
S_inv <- solve(S)

# Number of observations and vector size
n <- nrow(data1)
p <- ncol(data1)

# Calculate squared Mahalanobis distances
d2 <- numeric(n)
for (i in 1:n) {
  y <- t(as.matrix(data1[i, ]))
  d2[i] <- t(y - xb) %*% S_inv %*% (y - xb)
}

# Display distances
d2

# Plot T^2 chart
plot(d2,
     ylim = c(0, 14),
     main = "T^2 Chart (Example 5.11)",
     xlab = "Observation",
     ylab = "Squared Mahalanobis Distance")

# Chi-square limits
chq_99 <- qchisq(0.99, df = p)
chq_95 <- qchisq(0.95, df = p)

abline(h = chq_99, col = "blue")
abline(h = chq_95, col = "red")

#---------------------------------------------
# Scatter Plot of X1 vs log(X4)
#---------------------------------------------

plot(data1$X1, log(data1$X4),
     main = "Scatter Plot: X1 vs log(X4)",
     xlab = "X1",
     ylab = "log(X4)")

#---------------------------------------------
# Confidence Ellipse
#---------------------------------------------

# Load ellipse package
# install.packages("ellipse")  # Uncomment if not installed
library(ellipse)

# Transform X4 to log scale
data1$logX4 <- log(data1$X4)
data2 <- data1[, c("X1", "logX4")]

# Covariance matrix and center
cov_matrix <- cov(data2)
x <- data2$X1
y <- data2$logX4
center <- c(mean(x), mean(y))

# Generate confidence ellipse
ellipse_data <- ellipse(cov_matrix, centre = center, level = 0.99)

# Plot x-y points and ellipse
plot(x, y,
     xlim = range(ellipse_data[, 1]),
     ylim = range(ellipse_data[, 2] + 0.005),
     main = "Confidence Ellipse (X1 vs log(X4))",
     xlab = "X1",
     ylab = "log(X4)")

lines(ellipse_data, col = "blue")

#---------------------------------------------
# Control Chart for log(X4)
#---------------------------------------------

mean_logX4 <- mean(data2$logX4)
sd_logX4 <- sd(data2$logX4)

LCL <- mean_logX4 - 3 * sd_logX4
UCL <- mean_logX4 + 3 * sd_logX4

# Plot control chart
plot(data2$logX4,
     ylim = c(3.89, 4.02),
     main = "Control Chart for log(X4)",
     xlab = "Observation",
     ylab = "log(X4)")

abline(h = LCL, col = "blue")
abline(h = UCL, col = "red")