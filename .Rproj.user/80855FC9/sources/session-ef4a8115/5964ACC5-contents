############################
# 9. CV-BASED THRESHOLD OPTIMIZATION
############################

library(caret)

set.seed(123)
folds <- createFolds(train_data$churn, k = 5)

threshold_grid <- seq(0.05, 0.95, by = 0.01)

cv_profit_results <- sapply(threshold_grid, function(t) {
  
  fold_profits <- sapply(folds, function(idx) {
    
    cv_train <- train_data[-idx, ]
    cv_valid <- train_data[idx, ]
    
    # Recompute weights for fold
    w_total <- nrow(cv_train)
    w_min <- sum(cv_train$churn == 1)
    w_maj <- sum(cv_train$churn == 0)
    
    fold_weights <- ifelse(cv_train$churn == 1,
                           w_total/(2*w_min),
                           w_total/(2*w_maj))
    
    fold_model <- glm(
      churn ~ .,
      data = cv_train,
      family = binomial,
      weights = fold_weights
    )
    
    probs <- predict(fold_model, cv_valid, type = "response")
    preds <- ifelse(probs >= t, 1, 0)
    
    cm <- table(preds, cv_valid$churn)
    
    # ---- PROFIT MATRIX (Adjust as needed) ----
    profit_tp <- 100
    cost_fp   <- -10
    cost_fn   <- -200
    profit_tn <- 0
    
    tp <- ifelse("1" %in% rownames(cm) & "1" %in% colnames(cm), cm["1","1"], 0)
    fp <- ifelse("1" %in% rownames(cm) & "0" %in% colnames(cm), cm["1","0"], 0)
    fn <- ifelse("0" %in% rownames(cm) & "1" %in% colnames(cm), cm["0","1"], 0)
    tn <- ifelse("0" %in% rownames(cm) & "0" %in% colnames(cm), cm["0","0"], 0)
    
    tp*profit_tp + fp*cost_fp + fn*cost_fn + tn*profit_tn
  })
  
  mean(fold_profits)
})

best_threshold <- threshold_grid[which.max(cv_profit_results)]
best_threshold

############################
# 10. FINAL TEST EVALUATION
############################

