############################
# 4. FEATURE ENGINEERING
############################

# Log Transformation of Age
bank_raw <- bank_raw %>%
  mutate(age = log(age)+0.00123)

# One-Hot Encoding
# Using '-1' to get a column for every category level
y <- factor(bank_raw$churn)
X <- model.matrix(~ . - churn, data = bank_raw)

bank_data <- as.data.frame(X)
bank_data$churn <- y


############################
# 5. TRAIN / TEST SPLIT
############################


# Split the data into training and testing sets
split <- sample.split(bank_data$churn, SplitRatio = 0.70)
train_data <- subset(bank_data, split == TRUE)
test_data <- subset(bank_data, split == FALSE)


# Scale numeric columns (Fit on train ONLY to avoid leakage)
scaler_params <- preProcess(train_data[, numeric_columns], method = c("center", "scale"))

# Apply the transformation to both dataset
train_data[, numeric_columns] <- predict(scaler_params, train_data[, numeric_columns])
test_data[, numeric_columns] <- predict(scaler_params, test_data[, numeric_columns])

# Verify results
summary(train_data[, numeric_columns])


############################
# 6. HANDLING CLASS IMBALANCE
############################

# Weights for Weighted Logistic
w_total <- nrow(train_data)
w_min <- sum(train_data$churn == 1)
w_maj <- sum(train_data$churn == 0)
case_weights <- ifelse(train_data$churn == 1, 
                                  w_total / (2 * w_min), 
                                  w_total / (2 * w_maj))




# Prepare Data for SMOTE
smote_output <- SMOTE(X = as.data.frame(train_data %>% select(-churn)), 
                      target = train_data$churn, K = 5, dup_size = 0)
train_smote <- smote_output$data %>% rename(churn = class) %>% 
                      mutate(churn = as.factor(churn))



# Downsampling
down_train <- downSample(x = train_data %>% select(-churn),
                         y = train_data$churn,
                         yname = "churn")


############################
# 7. MODELING & EVALUATION
############################

# Evaluation Function
evaluate_model <- function(probs, y_true, threshold = 0.5, model_name) {
  
  preds <- factor(ifelse(probs >= threshold, 1, 0), levels = c(0, 1))
  y_true_fact <- factor(y_true, levels = c(0, 1))
  cm <- confusionMatrix(preds, y_true_fact, positive = "1")
  
  # 2. AUC Calculation (Threshold-independent)
  y_true_num <- as.numeric(as.character(y_true))
  roc_obj <- roc(y_true_num, probs, quiet = TRUE)
  auc_score <- as.numeric(auc(roc_obj))
  
  tibble(
    Model = model_name,
    Accuracy = cm$overall["Accuracy"],
    AUC = auc_score,
    #Balanced_Accuracy = cm$byClass["Balanced Accuracy"],
    Recall = cm$byClass["Sensitivity"],
    Precision = cm$byClass["Pos Pred Value"],
    F1 = cm$byClass["F1"]
  )
}


# Fitting Models
base_fit <- glm(churn ~ ., data = train_data, family = binomial)
weight_fit <- glm(churn ~ ., data = train_data, family = quasibinomial, weights = case_weights)
smote_fit <- glm(churn ~ ., data = train_smote, family = binomial)
down_fit <- glm(churn ~ ., data = down_train, family = binomial)


# Generating probability vectors for train
probs_base_train   <- predict(base_fit,   train_data, type = "response")
probs_weight_train <- predict(weight_fit, train_data, type = "response")
probs_smote_train  <- predict(smote_fit,  train_smote, type = "response")
probs_down_train  <- predict(down_fit,   down_train, type = "response")


# Generating probability vectors for test
probs_base   <- predict(base_fit,   test_data, type = "response")
probs_weight <- predict(weight_fit, test_data, type = "response")
probs_smote  <- predict(smote_fit,  test_data, type = "response")
probs_down   <- predict(down_fit,   test_data, type = "response")


# Aggregating Results for train
results_train <- bind_rows(
  evaluate_model(probs_base_train,   train_data$churn, threshold = 0.5, "Baseline"),
  evaluate_model(probs_weight_train, train_data$churn, threshold = 0.5, "Weighted"),
  evaluate_model(probs_smote_train,  train_smote$churn, threshold = 0.5, "SMOTE"),
  evaluate_model(probs_down_train,   down_train$churn, threshold = 0.5, "Downsampled")
)

# --- E. Final Inspection ---
print("--- Training Performance ---")
print(results_train)


# Aggregating Results for test
results <- bind_rows(
  evaluate_model(probs_base,   test_data$churn, threshold = 0.5, "Baseline"),
  evaluate_model(probs_weight, test_data$churn, threshold = 0.5, "Weighted"),
  evaluate_model(probs_smote,  test_data$churn, threshold = 0.5, "SMOTE"),
  evaluate_model(probs_down,   test_data$churn, threshold = 0.5, "Downsampled")
)

# --- E. Final Inspection ---
print("--- Final Model Comparison ---")
print(results)


############################
# 7. VARIABLE IMPORTANCE
############################
