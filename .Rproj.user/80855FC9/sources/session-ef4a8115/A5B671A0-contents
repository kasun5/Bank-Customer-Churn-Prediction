)

# Install missing packages
install_if_missing <- function(packages) {
  new_packages <- packages[!(packages %in% installed.packages()[,"Package"])]
  if(length(new_packages)) install.packages(new_packages)
}

install_if_missing(required_packages)

# Load libraries
invisible(lapply(required_packages, library, character.only = TRUE))

# Set random seed for reproducibility
set.seed(123)

# Create output directories
dir.create("plots", showWarnings = FALSE, recursive = TRUE)
dir.create("models", showWarnings = FALSE, recursive = TRUE)
dir.create("results", showWarnings = FALSE, recursive = TRUE)


# =============================================================================
# 2. DATA LOADING AND INITIAL PREPROCESSING
# =============================================================================

message("Loading data...")

# Load data
data_path <- here("data", "Bank_Customer_Churn_Data.csv")

if (!file.exists(data_path)) {
  stop("Data file not found. Please ensure 'Bank_Customer_Churn_Data.csv' is in the 'data' folder.")
}

bank_raw <- read.csv(data_path, stringsAsFactors = FALSE)

message(sprintf("Data loaded: %d rows, %d columns", nrow(bank_raw), ncol(bank_raw)))

# Initial data exploration
cat("\n--- Initial Data Structure ---\n")
str(bank_raw)

cat("\n--- Missing Values Summary ---\n")
missing_summary <- colSums(is.na(bank_raw))
print(missing_summary[missing_summary > 0])

if (sum(missing_summary) == 0) {
  message("✓ No missing values detected.")
}


# =============================================================================
# 3. DATA CLEANING AND TYPE CONVERSION
# =============================================================================

message("\nCleaning and preprocessing data...")

# Remove customer_id (non-predictive identifier)
bank_raw <- bank_raw %>% 
  select(-customer_id)

# Convert target variable to factor
bank_raw$churn <- factor(bank_raw$churn, levels = c(0, 1), labels = c("No", "Yes"))

# Convert categorical variables to factors
bank_raw <- bank_raw %>%
  mutate(
    products_number = as.factor(products_number),
    credit_card = as.factor(credit_card),
    active_member = as.factor(active_member)
  )

# Display class distribution
cat("\n--- Target Variable Distribution ---\n")
churn_table <- table(bank_raw$churn)
churn_prop <- prop.table(churn_table) * 100
print(churn_table)
cat(sprintf("Churn Rate: %.2f%% (imbalanced dataset)\n", churn_prop["Yes"]))

# Identify numeric and categorical columns
numeric_columns <- bank_raw %>%
  select(where(is.numeric)) %>%
  colnames()

categorical_columns <- bank_raw %>%
  select(where(~ is.factor(.x) | is.character(.x))) %>%
  colnames()

# Remove target from categorical columns for plotting
categorical_columns <- setdiff(categorical_columns, "churn")


# =============================================================================
# 4. EXPLORATORY DATA ANALYSIS
# =============================================================================

message("\nGenerating EDA visualizations...")

# --- 4.1 Numeric Variable Distributions ---
hist_list <- lapply(numeric_columns, function(col) {
  ggplot(bank_raw, aes(x = .data[[col]])) +
