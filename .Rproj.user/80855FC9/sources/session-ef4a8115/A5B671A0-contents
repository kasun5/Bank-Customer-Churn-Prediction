ggsave("plots/04_correlation_matrix.png", corr_plot, width = 8, height = 6, dpi = 300)

message("✓ EDA visualizations saved to 'plots' folder.")


# =============================================================================
# 5. FEATURE ENGINEERING
# =============================================================================

message("\nApplying feature engineering...")

# Log transformation of age (adding small constant to handle edge cases)
# Note: This transformation can help normalize the age distribution
bank_raw <- bank_raw %>%
  mutate(age_log = log(age + 0.00123))

# One-hot encoding for modeling
# Remove intercept column to avoid multicollinearity
y <- bank_raw$churn
X <- model.matrix(~ . - churn - age, data = bank_raw)[, -1]  # Remove intercept

# Combine into single dataframe
bank_data <- as.data.frame(X)
bank_data$churn <- y

cat(sprintf("\n✓ Feature engineering complete. Final dataset: %d rows, %d features\n", 
            nrow(bank_data), ncol(bank_data) - 1))


# =============================================================================
# 6. TRAIN/TEST SPLIT
# =============================================================================

message("\nSplitting data into train and test sets...")

# 70/30 train/test split with stratification
split_idx <- sample.split(bank_data$churn, SplitRatio = 0.70)
train_data <- subset(bank_data, split_idx == TRUE)
test_data <- subset(bank_data, split_idx == FALSE)

cat(sprintf("Training set: %d samples (%.1f%%)\n", 
            nrow(train_data), 
            nrow(train_data)/nrow(bank_data) * 100))
cat(sprintf("Test set: %d samples (%.1f%%)\n", 
            nrow(test_data), 
            nrow(test_data)/nrow(bank_data) * 100))

# Update numeric columns to include engineered features
numeric_columns <- c(numeric_columns[numeric_columns != "age"], "age_log")

# Feature scaling (CRITICAL: fit on training data only to prevent data leakage)
message("Scaling numeric features...")

scaler_params <- preProcess(
  train_data[, numeric_columns], 
  method = c("center", "scale")
)

train_data[, numeric_columns] <- predict(scaler_params, train_data[, numeric_columns])
test_data[, numeric_columns] <- predict(scaler_params, test_data[, numeric_columns])

# Save scaler for future use
saveRDS(scaler_params, "models/scaler_params.rds")
message("✓ Scaler parameters saved for deployment.")


# =============================================================================
# 7. HANDLING CLASS IMBALANCE
# =============================================================================

message("\nAddressing class imbalance...")

# --- 7.1 Class Weights for Weighted Logistic Regression ---
n_total <- nrow(train_data)
n_minority <- sum(train_data$churn == "Yes")
n_majority <- sum(train_data$churn == "No")

# Convert to numeric for weight calculation
train_data_numeric <- train_data
train_data_numeric$churn <- as.numeric(train_data$churn) - 1

case_weights <- ifelse(
  train_data_numeric$churn == 1,
  n_total / (2 * n_minority),
  n_total / (2 * n_majority)
)

cat(sprintf("Class weights - Majority: %.2f, Minority: %.2f\n",
            n_total / (2 * n_majority),
            n_total / (2 * n_minority)))

# --- 7.2 SMOTE (Synthetic Minority Oversampling) ---
message("Applying SMOTE...")

smote_output <- SMOTE(
  X = train_data_numeric %>% select(-churn),
  target = train_data_numeric$churn,
  K = 5,
  dup_size = 0
)

train_smote <- smote_output$data %>%
  rename(churn = class) %>%
  mutate(churn = factor(churn, levels = c(0, 1), labels = c("No", "Yes")))

cat(sprintf("✓ SMOTE applied - New training size: %d samples (balanced)\n", nrow(train_smote)))

# --- 7.3 Random Downsampling ---
message("Applying downsampling...")

train_downsampled <- downSample(
  x = train_data %>% select(-churn),
  y = train_data$churn,
  yname = "churn"
)

cat(sprintf("✓ Downsampling applied - New training size: %d samples (balanced)\n", 
            nrow(train_downsampled)))


# =============================================================================
# 8. MODEL TRAINING
# =============================================================================

message("\nTraining logistic regression models...")

# --- 8.1 Baseline Model (No class balancing) ---
message("  - Training baseline model...")
model_baseline <- glm(
  churn ~ .,
  data = train_data,
  family = binomial(link = "logit")
)

# --- 8.2 Weighted Model ---
message("  - Training weighted model...")
model_weighted <- glm(
  churn ~ .,
  data = train_data,
  family = quasibinomial(link = "logit"),
  weights = case_weights
)

# --- 8.3 SMOTE Model ---
message("  - Training SMOTE model...")
model_smote <- glm(
  churn ~ .,
  data = train_smote,
  family = binomial(link = "logit")
)

# --- 8.4 Downsampled Model ---
message("  - Training downsampled model...")
model_downsampled <- glm(
  churn ~ .,
  data = train_downsampled,
  family = binomial(link = "logit")
)

# Save models
saveRDS(model_baseline, "models/model_baseline.rds")
saveRDS(model_weighted, "models/model_weighted.rds")
saveRDS(model_smote, "models/model_smote.rds")
saveRDS(model_downsampled, "models/model_downsampled.rds")

message("✓ Models saved to 'models' folder.")


# =============================================================================
# 9. MODEL EVALUATION
# =============================================================================

message("\nEvaluating models...")

# Custom evaluation function with AUC
evaluate_model <- function(model, data, model_name, threshold = 0.5, set_name = "Test") {
  
  # Generate predictions
  probs <- predict(model, newdata = data, type = "response")
  preds <- factor(
    ifelse(probs >= threshold, "Yes", "No"),
    levels = c("No", "Yes")
  )
  
  # Convert to numeric for confusion matrix (0, 1)
  preds_numeric <- factor(
    ifelse(probs >= threshold, 1, 0),
    levels = c(0, 1)
  )
  churn_numeric <- factor(
    as.numeric(data$churn) - 1,
    levels = c(0, 1)
  )
  
  # Confusion matrix
  cm <- confusionMatrix(preds_numeric, churn_numeric, positive = "1")
  
  # AUC calculation (threshold-independent metric)
  y_true_num <- as.numeric(as.character(churn_numeric))
  roc_obj <- roc(y_true_num, probs, quiet = TRUE)
  auc_score <- as.numeric(auc(roc_obj))
  
  # Extract metrics
  tibble(
    Model = model_name,
    Set = set_name,
    Threshold = threshold,
    Accuracy = cm$overall["Accuracy"],
    AUC = auc_score,
    Sensitivity = cm$byClass["Sensitivity"],  # Recall / True Positive Rate
    Specificity = cm$byClass["Specificity"],  # True Negative Rate
    Precision = cm$byClass["Pos Pred Value"],
    F1_Score = cm$byClass["F1"]
  )
}

# --- 9.1 Training Set Performance ---
message("Evaluating on training set...")

results_train <- bind_rows(
  evaluate_model(model_baseline, train_data, "Baseline", set_name = "Train"),
  evaluate_model(model_weighted, train_data, "Weighted", set_name = "Train"),
  evaluate_model(model_smote, train_smote, "SMOTE", set_name = "Train"),
  evaluate_model(model_downsampled, train_downsampled, "Downsampled", set_name = "Train")
)

cat("\n")
cat("=" , rep("=", 90), "\n", sep = "")
cat("  TRAINING SET PERFORMANCE\n")
cat("=" , rep("=", 90), "\n", sep = "")
print(results_train, n = Inf)
cat("=" , rep("=", 90), "\n", sep = "")

# --- 9.2 Test Set Performance ---
message("\nEvaluating on test set...")

results_test <- bind_rows(
  evaluate_model(model_baseline, test_data, "Baseline", set_name = "Test"),
  evaluate_model(model_weighted, test_data, "Weighted", set_name = "Test"),
  evaluate_model(model_smote, test_data, "SMOTE", set_name = "Test"),
  evaluate_model(model_downsampled, test_data, "Downsampled", set_name = "Test")
)

cat("\n")
cat("=" , rep("=", 90), "\n", sep = "")
cat("  TEST SET PERFORMANCE (FINAL EVALUATION)\n")
cat("=" , rep("=", 90), "\n", sep = "")
print(results_test, n = Inf)
cat("=" , rep("=", 90), "\n", sep = "")

# --- 9.3 Combined Results ---
results_combined <- bind_rows(results_train, results_test)

# Save results
write.csv(results_train, "results/model_comparison_train.csv", row.names = FALSE)
write.csv(results_test, "results/model_comparison_test.csv", row.names = FALSE)
write.csv(results_combined, "results/model_comparison_combined.csv", row.names = FALSE)

message("\n✓ Results saved to 'results' folder.")

# --- 9.4 Check for Overfitting ---
cat("\n--- Overfitting Analysis ---\n")
overfitting_check <- results_combined %>%
  select(Model, Set, Accuracy, AUC, F1_Score) %>%
  tidyr::pivot_wider(names_from = Set, values_from = c(Accuracy, AUC, F1_Score)) %>%
  mutate(
    Accuracy_Diff = Accuracy_Train - Accuracy_Test,
    AUC_Diff = AUC_Train - AUC_Test,
    F1_Diff = F1_Score_Train - F1_Score_Test
  )

print(overfitting_check)
cat("\nNote: Large differences indicate potential overfitting.\n")

# --- 9.5 Identify Best Model ---
best_model_name <- results_test %>%
  arrange(desc(F1_Score)) %>%
  slice(1) %>%
  pull(Model)

best_f1 <- results_test %>%
  arrange(desc(F1_Score)) %>%
  slice(1) %>%
  pull(F1_Score)

best_auc <- results_test %>%
  filter(Model == best_model_name) %>%
  pull(AUC)

message(sprintf("\n🏆 Best performing model: %s (F1: %.4f, AUC: %.4f)", 
                best_model_name, best_f1, best_auc))


