
############################################################
# Example 4.12 - Mahalanobis Distance Calculation
############################################################
getwd()
# ---------------------------
# Reading data
# ---------------------------
data1 <- read.table("ex_4_12.txt", header = TRUE)
cat("Full dataset:\n")
print(data1)

# ---------------------------
# Remove last column to get the data matrix
# ---------------------------
data2 <- data1[, -3]
cat("\nData matrix (after removing last column):\n")
print(data2)

# ---------------------------
# Covariance matrix
# ---------------------------
S <- cov(data2)
cat("\nCovariance matrix S:\n")
print(S)

# ---------------------------
# Mean vector
# ---------------------------
xb <- colMeans(data2)
cat("\nMean vector xb:\n")
print(xb)

# ---------------------------
# Inverse of covariance matrix
# ---------------------------
IN_S <- solve(S)
cat("\nInverse of covariance matrix:\n")
print(IN_S)

# ---------------------------
# Example vector x
# ---------------------------
x <- matrix(c(108.28, 17.05), 2, 1, byrow = TRUE)
cat("\nVector x:\n")
print(x)

# ---------------------------
# Squared Mahalanobis distance for x
# ---------------------------
d <- x - xb
dis <- t(d) %*% IN_S %*% d
cat("\nSquared Mahalanobis distance for x:\n")
print(dis)

# ---------------------------
# Chi-square value for probability 0.5 (df = 2)
# ---------------------------
chi <- qchisq(0.5, df = 2)
cat("\nChi-square quantile at 0.5 (df = 2):\n")
print(chi)

# ---------------------------
# Calculation of d2 for all points
# ---------------------------
n <- nrow(data2)  # define sample size
d2 <- numeric(n)  # vector to store squared distances

for (i in 1:n) {
  y <- as.numeric(data2[i, ])
  d <- y - xb
  d2[i] <- t(d) %*% IN_S %*% d
}

cat("\nSquared Mahalanobis distances (d2) for all points:\n")
print(d2)

############################################################
# End of Example 4.12
############################################################
