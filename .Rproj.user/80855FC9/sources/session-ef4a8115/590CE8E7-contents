############ Exercise 2.79 - Test for Angular Data ############
```{r}
# Install package
#install.packages("circular")
library(circular)

# Lunch times
times <- c("9:30","9:45","10:00","10:15","10:30","10:45",
           "11:00","11:15","11:30","11:45",
           "12:00","12:15","12:30","12:45",
           "1:00","1:15","1:30","1:45",
           "2:00","2:15")

# Convert time to numeric (24-hour format)
convert_time <- function(t){
  parts <- strsplit(t, ":")[[1]]
  hour <- as.numeric(parts[1])
  minute <- as.numeric(parts[2])
  
  if(hour < 9) hour <- hour + 12   # convert 1–2 PM
  
  hour + minute/60
}

time_numeric <- sapply(times, convert_time)

# Convert to radians
time_radians <- 2*pi*time_numeric/24
time_circular <- circular(time_radians, units="radians", template="clock24")

# Rayleigh test
test_result <- rayleigh.test(time_circular)

print(test_result)

# Decision at alpha = 0.05
alpha <- 0.05
if(test_result$p.value < alpha){
  cat("\nDecision: Reject H0.\n")
  cat("Conclusion: Lunch times are NOT uniformly distributed.\n")
} else {
  cat("\nDecision: Fail to reject H0.\n")
  cat("Conclusion: Lunch times are uniformly distributed around the circle.\n")
}
```

############ Exercise 2.89 ############
```{r}
# Given data
x <- c(9,5,7,2,3,4,7,2,
       8,7,6,9,4,1,1,6,7,3,6,2)

# -------------------------
# 1. Empirical distribution
# -------------------------
freq_table <- table(x)
rel_freq <- prop.table(freq_table)

cat("Frequency Table:\n")
print(freq_table)

cat("\nRelative Frequencies (Empirical Distribution):\n")
print(rel_freq)

# -------------------------
# 2. Chi-square Goodness-of-Fit Test
# H0: Data ~ Binomial(n=9, p=0.5)
# -------------------------

n <- 9
p <- 0.5

# Expected probabilities
k <- 0:n
expected_probs <- dbinom(k, size = n, prob = p)

# Expected counts
expected_counts <- length(x) * expected_probs

# Match observed counts to 0:9
observed_counts <- numeric(length = length(k))
names(observed_counts) <- k

for(i in names(freq_table)){
  observed_counts[i] <- freq_table[i]
}

# Chi-square test
test <- chisq.test(observed_counts,
                   p = expected_probs,
                   rescale.p = TRUE)

print(test)

# -------------------------
# 3. Decision
# -------------------------
alpha <- 0.05

if(test$p.value < alpha){
  cat("\nDecision: Reject H0\n")
  cat("Conclusion: Data is NOT from Binomial(9, 0.5)\n")
} else {
  cat("\nDecision: Fail to Reject H0\n")
  cat("Conclusion: Data follows Binomial(9, 0.5)\n")
}
```

############ Exercise 2.95 - Testing Kurtosis & Skewness for Normaity ############
```{r}
# Install package if needed
#install.packages("tseries")
#install.packages("moments")

library(tseries)
library(moments)

# Reaction time data
x <- c(473, 494, 441, 423, 418, 520, 454, 529, 523, 489,
       541, 472, 440, 503, 515, 496, 489, 526, 457, 421,
       473, 543, 535, 493, 445, 551, 487, 480, 404, 540)

# --------------------------
# 1. Skewness and Kurtosis
# --------------------------
sk <- skewness(x)
kt <- kurtosis(x)   # this gives regular kurtosis (normal = 3)

cat("Skewness =", sk, "\n")
cat("Kurtosis =", kt, "\n")

# --------------------------
# 2. Jarque-Bera Test
# H0: Data is normally distributed
# --------------------------
jb <- jarque.bera.test(x)
print(jb)

# --------------------------
# 3. Decision
# --------------------------
alpha <- 0.05

if(jb$p.value < alpha){
  cat("\nDecision: Reject H0\n")
  cat("Conclusion: Data is NOT normally distributed.\n")
} else {
  cat("\nDecision: Fail to Reject H0\n")
  cat("Conclusion: Data is consistent with a normal distribution.\n")
}
```

