X <- matrix(c(
  3, 9, 10,
  8, 6, 9,
  4, 3, 8,
  7, 6, 9,
  3, 6, 9
), nrow = 5, byrow = TRUE)

n<-nrow(X)
#Creating a nxn=5x5 identity matrix 
I<-diag(n)

#creating a nx1=5x1 matrix with ones
l<-matrix(1,n,1)

options(scipen = 999) ## Set option to suppress scientific notation

#Calculating the variance covariance matrix
S_RHS<-(1/(n-1))*t(X)%*%(I-(1/n)*l%*%t(l))%*%X
round(S_RHS,digits = 3)


S_LHS <- cov(X)
round(S_LHS,digits = 3)

message("\nTherefore, LHS = RHS")
