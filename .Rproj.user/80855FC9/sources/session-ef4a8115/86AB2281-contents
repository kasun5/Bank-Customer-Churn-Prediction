
#---------------------------------------------
# Hotelling's T^2 Test Calculation (Example 5.3)
#---------------------------------------------

# Reading data
data1 <- read.table("ex_5_2.txt", header = TRUE)

#---------------------------------------------
# Data Transformation
#---------------------------------------------

#X1 <- (data1$Closed)^(1/4)
#X2 <- (data1$Open)^(1/4)

#data2 <- data.frame(X1, X2)
data2 <- data1

#---------------------------------------------
# Basic Quantities
#---------------------------------------------

# Sample mean vector (x̄)
xb <- colMeans(data2)

# Sample covariance matrix (S)
S <- cov(data2)

# Inverse of covariance matrix (S^{-1})
S_inv <- solve(S)

# Sample size (n) and number of variables (p)
n <- nrow(data2)
p <- ncol(data2)

#---------------------------------------------
# Hypothesized Mean Vector (μ₀)
#---------------------------------------------

mu0 <- matrix(c(4, 5, 10), nrow = 3, ncol = 1)

# Convert sample mean to column vector
xb_vec <- matrix(xb, ncol = 1)

#---------------------------------------------
# Hotelling's T^2 Statistic
#---------------------------------------------

T2 <- n * t(xb_vec - mu0) %*% S_inv %*% (xb_vec - mu0)

#---------------------------------------------
# Critical Value (F-Distribution)
#---------------------------------------------

# F critical value at α = 0.05
F_val <- qf(0.90, df1 = p, df2 = n - p)

# Hotelling's T^2 critical value
critical_value <- ((n - 1) * p / (n - p)) * F_val

#---------------------------------------------
# Eigenvalues and Eigenvectors
#---------------------------------------------

ev <- eigen(S)

# Eigenvalues (λ)
lambda <- ev$values

# Eigenvectors
eigenvec <- ev$vectors

# Elongation (ratio of major to minor axis)
elongation <- sqrt(lambda[1]) / sqrt(lambda[2])

#---------------------------------------------
# Output
#---------------------------------------------

cat("Hotelling's T-squared (T2):\n")
print(T2)

cat("\nCritical Value:\n")
print(critical_value)

cat("\nEigenvalues (lambda):\n")
print(lambda)

cat("\nEigenvectors:\n")
print(eigenvec)

cat("\nElongation:\n")
print(elongation)

