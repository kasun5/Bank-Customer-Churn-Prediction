# Function to perform analysis
analyze_hair <- function(df, label) {
  n_sub <- nrow(df)
  x_bar <- colMeans(df)
  S <- cov(df)
  
  # F-critical value for Hotelling's T2
  crit_val <- (p * (n_sub - 1) / (n_sub - p)) * qf(1 - alpha, p, n_sub - p)
  
  # (b) Simultaneous 90% Confidence Intervals (T2 intervals)
  # Formula: mean +/- sqrt(crit_val) * sqrt(s_ii / n)
  se <- sqrt(diag(S) / n_sub)
  intervals <- data.frame(
    Lower = x_bar - sqrt(crit_val) * se,
    Upper = x_bar + sqrt(crit_val) * se
  )
  
  cat("\n--- Analysis for:", label, "---\n")
  cat("Mean Vector:\n"); print(x_bar)
  cat("Confidence Intervals:\n"); print(intervals)
  
  # Plotting the Ellipse
  library(car)
  plot(df$Cr, df$St, main=paste("90% Confidence Ellipse:", label),
       xlab="Chromium (x1)", ylab="Strontium (x2)", pch=19)
  confidenceEllipse(lm(cbind(Cr, St) ~ 1, data=df), 
                    levels=0.90, add=TRUE, col="blue")
}

