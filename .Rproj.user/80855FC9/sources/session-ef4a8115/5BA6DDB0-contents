# Q_9

```{r}
# Data: 10 largest companies
data2 <- matrix(c(
  108.28, 17.05, 1484.10,
  152.36, 16.59, 750.33,
  95.04,  10.91, 766.42,
  65.45,  14.14, 1110.46,
  62.97,   9.52, 1031.29,
  263.99, 25.33, 195.26,
  265.19, 18.54, 193.83,
  285.06, 15.73, 191.11,
  92.01,   8.10, 1175.16,
  165.68, 11.13, 211.15
), nrow = 10, byrow = TRUE)
colnames(data2) <- c("Sales", "Profits", "Assets")

print(data2)

# ---------------------------
# Covariance matrix
# ---------------------------
S <- cov(data2)
cat("\nCovariance matrix S:\n")
print(S)

# ---------------------------
# Mean vector
# ---------------------------
xb <- colMeans(data2)
cat("\nMean vector xb:\n")
print(xb)

# ---------------------------
# Inverse of covariance matrix
# ---------------------------
IN_S <- solve(S)
cat("\nInverse of covariance matrix:\n")
print(IN_S)

chi_x <- c(0.3518, 0.7978, 1.2125, 1.6416, 2.1095, 2.6430, 3.2831, 4.1083, 5.3170, 7.8147)

# ---------------------------
# Calculation of d2 for all points
# ---------------------------
n <- nrow(data2)  # define sample size
d2 <- numeric(n)  # vector to store squared distances

for (i in 1:n) {
  y <- as.numeric(data2[i, ])
  d <- y - xb
  d2[i] <- t(d) %*% IN_S %*% d
}
d2 <- sort(d2)
cat("\nSquared Mahalanobis distances (d2) for all points:\n")
print(d2)

plot(chi_x, d2, pch=19,
     xlab="Chi-square Quantiles",
     ylab="Squared Distances",
     main="Chi-square plot of the ordered distances")

```

