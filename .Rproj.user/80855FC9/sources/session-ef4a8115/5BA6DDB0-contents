# Q_8

### a)
```{r}
# ---------------------------
# Reading data
# ---------------------------
data1 <- c(-0.6, 3.1, 25.3, -16.8, -7.1, -6.2, 25.2, 22.6, 26.0)
# Sort the sample
data1 <- sort(data1)
cat("Full dataset:\n")
print(data1)  # print entire dataset

# ---------------------------
# Sample size
# ---------------------------
n <- length(data1)
cat("\nSample size (n):", n, "\n")

# ---------------------------
# Initialize vectors for probabilities and normal quantiles
# ---------------------------
prob <- numeric(n)          # Plotting positions
normal_quant <- numeric(n)  # Standard normal quantiles

# ---------------------------
# Compute probabilities and quantiles
# ---------------------------
for (i in 1:n) {
  y <- as.numeric(data1[i])
  prob[i] <- (i - 0.5) / n
  normal_quant[i] <- qnorm(prob[i])
}

cat("\nAll normal quantiles:\n")
print(normal_quant)  # print entire vector of quantiles

# ---------------------------
# Q-Q Plot
# ---------------------------
# Attach data for easy column access
#attach(data1)

# Custom Q-Q plot
plot(normal_quant, data1,
     xlab = "Standard Normal Quantiles",
     ylab = "X(j)",
     main = "Q-Q Plot",
     col = "black",
     pch = 19)

```
Yes data seems to be normally distributed. All points con be covered by a thick line


